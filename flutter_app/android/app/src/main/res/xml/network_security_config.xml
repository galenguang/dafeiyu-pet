<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9（API 28）起默认禁止明文 HTTP，连 127.0.0.1 也拦。
  我们的素材服务是 http://127.0.0.1:PORT（不加密，因为只在本机内存里走），
  不加这个配置 WebView 会报 net::ERR_CLEARTEXT_NOT_PERMITTED，页面白屏。

  刻意**不**用 android:usesCleartextTraffic="true" —— 那会对所有域名开放，
  等于把整个 App 的明文限制关掉。这里只放行 loopback，范围最小。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
